# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Google Apps Script Order Notification System
# GOOGLE_APPS_SCRIPT_URL: Web App URL deployed from Google Apps Script (https://script.google.com/macros/s/.../exec)
GOOGLE_APPS_SCRIPT_URL=

# ADMIN_EMAIL: Administrator Gmail inbox receiving new order alerts and replying directly to customers
ADMIN_EMAIL="globalherbsinc@gmail.com"
