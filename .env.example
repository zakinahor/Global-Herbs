# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ============================================================================
# SERVER-SIDE EMAIL & ORDER NOTIFICATION CONFIGURATION
# ============================================================================
# ADMIN_EMAIL: Administrator inbox receiving all customer order & form notifications
ADMIN_EMAIL="globalherbsinc@gmail.com"

# EMAIL_FROM: Configured sender email address / display identity
EMAIL_FROM="globalherbsinc@gmail.com"

# GOOGLE_APPS_SCRIPT_URL: Deployed Google Apps Script Web App URL (MailApp provider)
# Format: https://script.google.com/macros/s/.../exec
GOOGLE_APPS_SCRIPT_URL=

# GITHUB_TOKEN: GitHub Personal Access Token for repository push access
GITHUB_TOKEN=

# ============================================================================
# PRODUCTION DATABASE & AUTOMATED SEO BLOG PUBLISHING
# ============================================================================
# POSTGRES_URL / DATABASE_URL: Managed PostgreSQL connection string (Vercel Postgres, Neon, Supabase, Cloud SQL)
# Required in production for persistent blog articles, schedule configurations, and audit logs.
POSTGRES_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# CRON_SECRET: Secret Bearer token used by Vercel Cron to securely invoke /api/cron/publish
# Rotate this key in Vercel project settings at any time without code changes.
CRON_SECRET=

# BLOG_ADMIN_SECRET: Administrator authentication secret for manual dashboard management
BLOG_ADMIN_SECRET=

